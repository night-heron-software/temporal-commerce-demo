        {
          "name": "delivered",
          "doc": "Delivered — post-delivery lifecycle (feedback, refunds, returns). An admin\n'refunded' status is enriched into a real `refundOrder` command, so it records a\nrefund and trues up tax exactly (handles the case where partials came first).\nTimeouts are ignored (no `onTimeout`): the demo has no return-window auto-close.",
          "timeout": "30 days",
          "commands": [
            {
              "name": "submitFeedback"
            },
            {
              "name": "updateStatus",
              "guarded": true
            },
            {
              "name": "refundOrder",
              "guarded": true
            },
            {
              "name": "requestReturn"
            }
          ],
          "transitional": false,
          "hasPrepare": false,
          "hasFinalize": false,
          "transitions": [
            {
              "on": "FeedbackSubmitted",
              "kind": "event",
              "to": "__terminal:complete"
            },
            {
              "on": "Refunded",
              "kind": "event",
              "to": "delivered"
            },
            {
              "on": "ReturnRequested",
              "kind": "event",
              "to": "return_requested"
            },
            {
              "on": "OrderCancelled",
              "kind": "event",
              "to": "__terminal:cancelled"
            },
            {
              "on": "OrderProcessing",
              "kind": "event",
              "to": "processing"
            },
            {
              "on": "OrderPartiallyShipped",
              "kind": "event",
              "to": "partially_shipped"
            },
            {
              "on": "OrderShipped",
              "kind": "event",
              "to": "shipped"
            },
            {
              "on": "OrderDelivered",
              "kind": "event",
              "to": "delivered"
            },
            {
              "on": "OrderReturnRequested",
              "kind": "event",
              "to": "return_requested"
            },
            {
              "on": "OrderRefunded",
              "kind": "event",
              "to": "__terminal:refunded"
            },
            {
              "on": "OrderReturned",
              "kind": "event",
              "to": "__terminal:returned"
            },
            {
              "on": "OrderCompleted",
              "kind": "event",
              "to": "__terminal:complete"
            }
          ]
        },
        {
          "name": "return_requested",
          "doc": "A return has been requested on a delivered order. `confirmReturn` issues the refund\n(the decided `ReturnConfirmed` carries the record; the customer email is its effect)\nand finishes the order as `returned`; `denyReturn` clears the request and drops back\nto `delivered`. Timeouts are ignored — the demo has no review-SLA auto-close.",
          "timeout": "30 days",
          "commands": [
            {
              "name": "confirmReturn",
              "guarded": true
            },
            {
              "name": "denyReturn"
            }
          ],
          "transitional": false,
          "hasPrepare": false,
          "hasFinalize": false,
          "transitions": [
            {
              "on": "ReturnConfirmed",
              "kind": "event",
              "to": "__terminal:returned"
            },
            {
              "on": "ReturnDenied",
              "kind": "event",
              "to": "delivered"
            }
          ]
        }
