{
  "name": "temporal-commerce-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Full-stack e-commerce demo of Temporal durable execution — cart, checkout, order management, and fulfillment as workflows. Next.js 16, Temporal TypeScript SDK, Cassandra, Elasticsearch.",
  "keywords": [
    "temporal",
    "temporal-workflow",
    "durable-execution",
    "workflow-orchestration",
    "nextjs",
    "typescript",
    "react",
    "cassandra",
    "elasticsearch",
    "ecommerce",
    "cqrs",
    "state-machine",
    "saga-pattern"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/night-heron-software/temporal-commerce-demo.git"
  },
  "homepage": "https://github.com/night-heron-software/temporal-commerce-demo#readme",
  "author": "Jeff Romine",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "docs:diagrams": "node scripts/generate-state-diagrams.mjs",
    "docs:diagrams:check": "node scripts/generate-state-diagrams.mjs --strict && node scripts/generate-state-diagrams.mjs --check",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"scripts/**/*.{ts,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"scripts/**/*.{ts,mjs}\"",
    "dev:up": "concurrently --names \"storefront,workers\" --prefix-colors \"cyan,magenta\" --kill-others-on-fail \"npm run dev:storefront\" \"npm run dev:worker\"",
    "dev:down": "bash scripts/stop-dev.sh",
    "dev:stop-all": "npm run dev:down && npm run infra:down",
    "dev:start-all": "npm run infra:up && npm run dev:up",
    "dev:status": "bash scripts/status.sh",
    "dev:init": "bash scripts/init.sh",
    "dev:storefront": "npm run dev",
    "dev:worker": "tsx --env-file=.env.local ./src/temporal/worker.ts",
    "dev:validate": "tsx --env-file=.env.local scripts/validate-system.ts",
    "db:init": "docker exec -i demo-cassandra cqlsh < cassandra/schema.cql && echo '✓ Schema initialized'",
    "dev:seed": "tsx --env-file=.env.local ./scripts/seed.ts",
    "db:verify": "bash scripts/verify-schema.sh",
    "smoke:standalone": "node scripts/standalone-activity-smoke.cjs",
    "workers-wait": "tsx --env-file=.env.local scripts/wait-for-workers.ts",
    "infra:up": "bash scripts/infra-start.sh",
    "infra:up:obs": "docker compose -f docker-compose.yml -f docker-compose.observability.yml up -d",
    "infra:down": "bash scripts/local-shutdown.sh",
    "infra:clean": "npm run infra:down && docker-compose down -v && echo '✓ All data wiped'",
    "infra:ps": "docker-compose ps",
    "infra:ready": "bash scripts/docker-ready.sh"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.19.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.55.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/resources": "^1.30.0",
    "@opentelemetry/sdk-node": "^0.57.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "@temporalio/activity": "^1.19.0",
    "@temporalio/client": "^1.19.0",
    "@temporalio/common": "^1.19.0",
    "@temporalio/interceptors-opentelemetry": "^1.19.0",
    "@temporalio/worker": "^1.19.0",
    "@temporalio/workflow": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "cassandra-driver": "^4.8.0",
    "marked": "^18.0.5",
    "mermaid": "^11.16.0",
    "next": "16.2.4",
    "pino": "^10.3.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@temporalio/testing": "^1.19.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^25.6.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "concurrently": "^9.2.1",
    "eslint": "^9.28.0",
    "eslint-config-next": "16.2.4",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.7.4",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
